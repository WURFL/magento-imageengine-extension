{
  "name": "scientiamobile/module-magento2-image-cdn-imageengine",
  "description": "Image CDN Extension for Magento2 by ImageEngine",
  "require": {
    "php": "~7.1.0|~7.2.0|~7.3.0|~7.4.0|~8.1.0|~8.2.0|~8.3.0|~8.4.0|~8.5.0"
  },
  "version": "1.0.28",
  "license": "MIT",
  "type": "magento2-module",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "ScientiaMobile\\IO\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
